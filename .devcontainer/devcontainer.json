{
  "name": "Whisper Transcriber PWA",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ffmpeg && pip install -r backend/requirements.txt && cd frontend && npm install",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "Vite frontend", "onAutoForward": "openBrowser" },
    "8000": { "label": "FastAPI backend", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Vue.volar",
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
